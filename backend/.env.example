# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Configurations
MONGO_URI=mongodb://localhost:27017/scenecraft
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Upload Configurations
MAX_FILE_SIZE_MB=15
UPLOAD_DIR=uploads/
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# Storage Service Configuration (local or s3 for manuscripts)
STORAGE_PROVIDER=local

# AWS S3 Configurations (Required only if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# Cloudinary Configuration (Covers & Avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seeded Admin Configuration (Used by npm run seed:admin)
ADMIN_EMAIL=admin@scenecraft.com
ADMIN_PASSWORD=supersecureadminpass123!

# OpenRouter AI Configuration
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_MODEL_1=google/gemini-2.5-flash
OPENROUTER_MODEL_2=google/gemini-2.5-flash
OPENROUTER_MODEL_3=google/gemini-2.5-flash
OPENROUTER_MAX_TOKENS=4096
